# Paste your key into .hermes/.env locally. Never send it in chat.
DEEPSEEK_API_KEY=

# All decision entry points prefer local Laya; Jev is the cloud backup.
# Main planning/generation model selection is independent.
MINICLAW_DECISION_PROVIDER=laya
MINICLAW_CHAT_DECISION_PROVIDER=inherit
MINICLAW_LAYA_URL=http://127.0.0.1:8771
MINICLAW_LAYA_TIMEOUT=3
MINICLAW_LAYA_CHECKPOINT_SHA256=6c1d336ea08c1bd87292c573a393a7ed0b58bb8ce5b7a60a79cb72456083d041
MINICLAW_LAYA_GATE_SHA256=69639c48ac04dbe6de7fb99a098a7d184acf1e16a32b823efe52b4112694f315
TYPESAFE_API_KEY=

# Chat fallback (qwen-plus, China region) and optional AI image edits.
DASHSCOPE_API_KEY=
MINICLAW_CHAT_FALLBACK_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MINICLAW_IMAGE_MODEL=qwen-image-edit-max
MINICLAW_IMAGE_BASE_URL=https://dashscope.aliyuncs.com
